{
  "expo": {
    "name": "GroupSync",
    "slug": "groupsync",
    "scheme": "groupsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.groupsync.app"
    },
    "android": {
      "package": "com.groupsync.app"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
